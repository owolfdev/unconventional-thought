# Dependencies
node_modules/
.next/
.venv*/
__pycache__/
*.py[cod]

# Secrets
.env
.env.local
.env.*.local

# Remotion renders
remotion/out/

# -----------------------------------------------------------------------------
# media_tool/public/media — commit JSON metadata only; all binaries stay local
# See media_tool/docs/GIT_AND_MEDIA.md
# -----------------------------------------------------------------------------
media_tool/public/media/**
!media_tool/public/media/
!media_tool/public/media/**/
!media_tool/public/media/.gitkeep
!media_tool/public/media/**/*.json
!media_tool/public/media/**/.gitkeep
!media_tool/public/media/**/README.md

# Scratch downloads / uploads during dev (never commit)
media_tool/public/tmp/*
!media_tool/public/tmp/.gitkeep

# Raw VO sources (local)
vo_source/*
!vo_source/.gitkeep

# Episode-local media downloads (optional; uncomment if you move fetch under episodes/)
# episodes/**/media/fetch/*
# episodes/**/media/manual/*

# Master audio / video (large — restore from backup or regenerate)
episodes/**/audio/master/*.mp3
episodes/**/audio/master/*.wav
episodes/**/audio/segments/*.mp3
episodes/**/audio/preview/*.mp3

# VO work-in-progress (parts, review renders, archives — local only)
episodes/**/audio/vo/**/*.mp3
episodes/**/audio/vo/**/*.mp4
episodes/**/audio/vo/**/*.wav
episodes/**/audio/vo/**/*.m4a
episodes/**/audio/vo/**/*.png

# Large episode graphics sources (keep small PNG comps in git if desired)
episodes/**/graphics/**/*.af
episodes/**/graphics/thumbnail.jpg
episodes/**/media/**/*.af

# OS / editor
.DS_Store
*.swp
.idea/
.vscode/

# Audacity lock
*.aup3-wal
*.aup3-shm

# Temp render props (per-episode output folders)
remotion/out/**/.props/
